{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npx --yes pnpm@11.10.0 install --frozen-lockfile",
      "buildCommand": "cd ../.. && npx --yes pnpm@11.10.0 exec turbo run build --filter=@railway/web... --concurrency=4",
      "outputDirectory": "dist",
      "devCommand": "npx --yes pnpm@11.10.0 exec vite --host 0.0.0.0 --port ${PORT:-3000}",
      "bindings": []
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
